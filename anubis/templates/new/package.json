{
  "name": "anubis-starter",
  "private": true,
  "description": "The anubis-starter application.",
  "license": "UNLICENSED",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=20",
    "yarn": ">=4"
  },
  "scripts": {
    "dev": "yarn dev:env && docker compose --env-file .env -f compose.yaml up -d --wait && dotenv -- concurrently -n api,web -c blue,green \"cargo run -p anubis-starter\" \"yarn workspace anubis-starter-frontend dev\"",
    "dev:env": "node -e \"const fs = require('fs'); fs.existsSync('.env') || fs.copyFileSync('.env.example', '.env')\"",
    "build": "yarn workspaces foreach -A --topological run build",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "lint": "yarn workspaces foreach -A run lint",
    "lint:fix": "yarn workspaces foreach -A run lint:fix",
    "test": "yarn workspaces foreach -A run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "dotenv-cli": "^8.0.0"
  },
  "packageManager": "yarn@4.17.0"
}
