    "react-i18next": "^15.4.0"
  },
  "devDependencies": {
    "@jalapenolabs/cli": "https://github.com/jalapenolabs/cli.git",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "eslint": "^9.0.0",
    "jiti": "^2.4.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "yarn@4.17.0"
