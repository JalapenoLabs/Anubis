{
  "name": "anubis-starter-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "The Anubis starter application frontend, stamped out by `anubis new`.",
  "license": "MIT",
  "author": "Jalapeno Labs",
  "type": "module",
  "engines": {
    "node": ">=20",
    "yarn": ">=4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
