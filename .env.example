# Development configuration for anubis-starter.
#
# `yarn dev` copies this file to `.env` when there is none, then loads it: the
# database container, the backend, and the frontend dev server all read one
# file. `.env` is git-ignored, so machine-specific values and anything real
# belong there. This file is committed, so it holds development values only.

# The development database. compose.yaml starts Postgres from these four
# values, and DATABASE_URL restates them for the backend, which speaks URLs.
POSTGRES_USER=anubis_starter
POSTGRES_PASSWORD=anubis-starter-dev-password
POSTGRES_DB=anubis_starter_development
# Off the default port, so a Postgres already running on the host never
# collides with this one.
POSTGRES_PORT=54321
# 127.0.0.1 rather than localhost, because Docker publishes this port on IPv4
# and `localhost` resolves to ::1 first on a dual-stack host. The driver tries
# the addresses in the order it is given them, so ::1 costs a full TCP connect
# timeout, around 21 seconds on Windows, every time the pool opens a
# connection. The request that pays it succeeds, which is what makes it look
# like the application stalled rather than the address being wrong. CI names
# the address too, so both stacks reach Postgres the same way.
DATABASE_URL=postgres://anubis_starter:anubis-starter-dev-password@127.0.0.1:54321/anubis_starter_development

# The origin the browser sees, which in development is the Vite dev server.
# Email links and OAuth redirect URIs are built from it.
APP_URL=http://localhost:5173

# Encrypts the secrets the application reads back, such as TOTP seeds.
# Development falls back to a built-in public key and warns at startup;
# production refuses to boot without one. Mint yours with:
#   anubis secret generate
# ANUBIS_SECRET_KEY=

# Delivers real email instead of writing it to the log. Both are required
# together.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=anubis-starter <no-reply@example.com>

# Fans realtime channels out across instances. Unset, channels are served in
# process, which is all one development server needs. Start the container
# first with compose.yaml's `realtime` profile, which reads the port here the
# way Postgres does.
# REDIS_PORT=63790
# REDIS_URL=redis://localhost:63790

# Extra browser origins allowed to call the API, comma separated. Unset means
# same-origin only, which is the shape `yarn dev` runs.
# CORS_ALLOWED_ORIGINS=https://admin.example.com

# Extra sources for the content security policy, per directive. The framework's
# policy covers the frontend it ships; this is where an analytics endpoint, an
# error ingest, or an image CDN goes. Sources join the framework's rather than
# replacing them.
# CSP_ALLOWED_SOURCES="script-src https://plausible.io; connect-src https://plausible.io"

# Turns billing on. Unset, every organization is on the free plan from
# config/billing.yml and checkout answers 503. Use a test-mode key in
# development: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...

# DKIM signing, only for relays that do not sign for you (see docs/email.md).
# DKIM_PRIVATE_KEY=
# DKIM_SELECTOR=mail
# DKIM_DOMAIN=
