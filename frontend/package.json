{
  "name": "@jalapenolabs/anubis",
  "version": "0.1.0",
  "description": "The Anubis framework frontend: app shell, field components, auth pages, and the generated-client runtime.",
  "keywords": [
    "anubis",
    "react",
    "saas",
    "framework",
    "jalapenolabs"
  ],
  "license": "MIT",
  "author": "Jalapeno Labs",
  "homepage": "https://github.com/JalapenoLabs/Anubis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JalapenoLabs/Anubis.git",
    "directory": "frontend"
  },
  "bugs": {
    "url": "https://github.com/JalapenoLabs/Anubis/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=20",
    "yarn": ">=4"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "yarn build",
    "clean": "rimraf dist coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@tiptap/core": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "@uiw/react-codemirror": "^4.23.0",
    "dompurify": "^3.2.0",
    "ky": "^2.0.2",
    "swr": "^2.5.0"
  },
  "peerDependencies": {
    "@heroui/react": ">=2.8.0 <3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": ">=7.60.0"
  },
  "devDependencies": {
    "@heroui/react": "^2.8.10",
    "@jalapenolabs/cli": "https://github.com/jalapenolabs/cli.git",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "eslint": "^9.0.0",
    "framer-motion": "^12.0.0",
    "happy-dom": "^20.11.6",
    "jiti": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "yarn@4.17.0"
}
